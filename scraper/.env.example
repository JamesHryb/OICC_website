# Copy this file to scraper/.env and fill in the four "Publish to web" CSV
# URLs from the Super Sixes Google Sheet once it exists (see
# scraper/SUPER_SIXES_GUIDE.md for how to get these). Leave unset to run
# scraper/super_sixes_manual.py against the local sample data instead.

SUPER_SIXES_TEAMS_CSV_URL=
SUPER_SIXES_FIXTURES_CSV_URL=
SUPER_SIXES_BATTING_CSV_URL=
SUPER_SIXES_BOWLING_CSV_URL=

# Existing PlayCricket scraper config (unrelated to Super Sixes) also lives
# in this file — see PLAYCRICKET_SETUP.md.
# PLAY_CRICKET_API_KEY=
# OICC_SITE_ID=
